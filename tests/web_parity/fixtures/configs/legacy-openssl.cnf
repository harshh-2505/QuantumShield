# System-wide OpenSSL defaults (web parity fixture)
openssl_conf = openssl_init

[openssl_init]
ssl_conf = ssl_module

[ssl_module]
system_default = tls_defaults

[tls_defaults]
MinProtocol = TLSv1
MaxProtocol = TLSv1.2
CipherString = DEFAULT:kRSA:!AESCCM8:!aNULL:@SECLEVEL=1
Ciphersuites = TLS_AES_128_GCM_SHA256
Groups = P-256:X25519:ffdhe2048
SignatureAlgorithms = RSA+SHA1:ECDSA+SHA256:rsa_pss_rsae_sha256

[pq_defaults]
MinProtocol = TLSv1.3
CipherString = ECDHE+AESGCM:-aECDSA:AESGCM:!PSK:!aNULL
Curves = *X25519MLKEM768:X25519

[legacy_client]
# MaxProtocol caps the version; a legacy cap means no TLS 1.3, not legacy enabled.
MaxProtocol = TLSv1.1
