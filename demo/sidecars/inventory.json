{
  "proxies": [
    {
      "name": "inventory-ingress",
      "mode": "ingress",
      "listen": "0.0.0.0:8443",
      "upstream": "127.0.0.1:443",
      "upstream_tls": true,
      "policy": "strict",
      "require_client_cert": true,
      "cert": "/pki/pqc/inventory.crt",
      "key": "/pki/pqc/inventory.key",
      "ca": "/pki/pqc/ca.crt",
      "allowed_ids": [
        "spiffe://quantumshield.local/orders",
        "spiffe://quantumshield.local/scanner"
      ],
      "sigalgs": "mldsa65:mldsa87"
    }
  ]
}
